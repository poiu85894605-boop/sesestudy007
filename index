                { id: "b2", answer: "고종", initial_sound: "ㄱㅈ", hint: "나라의 이름을 '대한제국'으로 바꾸고 스스로 조선의 첫 번째 황제가 된 왕은 누구일까요?", x: 6, y: 1, direction: "across", number: 2 },
                { id: "b3", answer: "안중근", initial_sound: "ㅇㅈㄱ", hint: "하얼빈역에서 우리나라를 침략한 일본의 앞잡이 이토 히로부미를 처단한 독립운동가는 누구일까요?", x: 6, y: 3, direction: "across", number: 3 },
                { id: "b4", answer: "독도", initial_sound: "ㄷㄷ", hint: "경상북도 울릉군에 속해 있으며, 일본이 자기 땅이라고 우기지만 옛날부터 전해 내려온 우리나라 동쪽 끝의 영토는 어디일까요?", x: 8, y: 5, direction: "down", number: 4 },
