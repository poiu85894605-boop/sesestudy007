<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>한눈에 쏙! 근현대사 십자말풀이</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Pretendard Web Font for high legibility -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <style>
        body {
            font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            background-color: #E6F4F1;
            color: #2D3748;
            letter-spacing: -0.01em;
            word-break: keep-all;
        }
        /* Custom highlight for UDL readability */
        .key-highlight {
            background-color: #FEF08A;
            padding: 0.15rem 0.4rem;
            border-radius: 0.375rem;
            font-weight: 700;
            color: #854D0E;
        }
        /* Touch friendly sizing and high accessibility */
        .cell-box {
            transition: all 0.2s ease-in-out;
            user-select: none;
        }
        .cell-selected {
            background-color: #FEF3C7 !important;
            border-color: #F59E0B !important;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.4);
        }
        .cell-correct {
            background-color: #DCFCE7 !important;
            border-color: #22C55E !important;
            color: #15803D !important;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-teal-200">

    <!-- Header & Score Bar -->
    <header class="bg-white/90 backdrop-blur-md border-b-2 border-teal-100 shadow-sm sticky top-0 z-20">
        <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-amber-400 text-amber-950 p-2.5 rounded-2xl shadow-inner font-black text-xl">
                    🇰🇷
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-slate-800 tracking-tight">
                        한눈에 쏙! 근현대사 십자말풀이
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 font-medium">느린 학습자를 위한 알기 쉬운 한국사 이야기</p>
                </div>
            </div>

            <!-- Stats Badge Group -->
            <div class="flex items-center gap-3 bg-amber-50 px-4 py-2 rounded-2xl border border-amber-200">
                <div class="flex items-center gap-1.5" title="보유 포인트">
                    <i class="fa-solid fa-star text-amber-500 text-lg"></i>
                    <span id="user-points" class="font-bold text-lg text-slate-800">0</span>
                    <span class="text-xs text-slate-500 font-bold">P</span>
                </div>
                <div class="h-4 w-[2px] bg-amber-200"></div>
                <div class="flex items-center gap-1.5" title="연속 정답 스트릭">
                    <i class="fa-solid fa-fire text-orange-500 text-lg"></i>
                    <span id="streak-count" class="font-bold text-lg text-slate-800">0</span>
                    <span class="text-xs text-slate-500 font-bold">연속</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto w-full px-4 py-6 flex-grow flex flex-col gap-6">
        
        <!-- Stage Selection Controls -->
        <nav class="flex justify-center gap-2 sm:gap-4">
            <button onclick="switchStage('beginner')" id="btn-stage-beginner" class="stage-btn flex-1 max-w-[160px] py-3 px-4 rounded-2xl font-bold text-base sm:text-lg border-2 border-amber-300 bg-amber-400 text-amber-950 shadow-sm transition-all hover:brightness-105 active:scale-95">
                🌱 초급
            </button>
            <button onclick="switchStage('intermediate')" id="btn-stage-intermediate" class="stage-btn flex-1 max-w-[160px] py-3 px-4 rounded-2xl font-bold text-base sm:text-lg border-2 border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:bg-slate-50 active:scale-95">
                🌿 중급
            </button>
            <button onclick="switchStage('advanced')" id="btn-stage-advanced" class="stage-btn flex-1 max-w-[160px] py-3 px-4 rounded-2xl font-bold text-base sm:text-lg border-2 border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:bg-slate-50 active:scale-95">
                🌳 고급
            </button>
        </nav>

        <!-- Game Area Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Crossword Grid View (Left Column) -->
            <section class="lg:col-span-7 bg-white rounded-3xl p-4 sm:p-6 border-2 border-amber-100 shadow-sm flex flex-col items-center justify-center min-h-[380px]">
                <div id="grid-container" class="relative bg-slate-100 p-2 sm:p-3 rounded-2xl border-2 border-slate-200 shadow-inner max-w-full overflow-x-auto">
                    <!-- Dynamic Grid will be rendered here by JavaScript -->
                </div>
                <p class="text-xs sm:text-sm text-slate-400 mt-4 flex items-center gap-1.5 font-medium">
                    <i class="fa-solid fa-hand-pointer text-amber-500"></i>
                    퍼즐 칸을 터치하면 문제가 나타납니다.
                </p>
            </section>

            <!-- Hint & Input Section (Right Column) -->
            <section class="lg:col-span-5 flex flex-col gap-4">
                
                <!-- Hint Display Box -->
                <div class="bg-white rounded-3xl p-5 border-2 border-amber-100 shadow-sm flex flex-col gap-3">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <span id="clue-badge" class="bg-amber-100 text-amber-900 font-bold px-3 py-1 rounded-full text-sm">
                            [힌트: 단어를 선택하세요]
                        </span>
                        <!-- TTS Button -->
                        <button onclick="speakCurrentHint()" title="음성으로 읽어주기" class="bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 p-2.5 rounded-xl transition-all flex items-center gap-1.5 font-bold text-xs active:scale-95">
                            <i class="fa-solid fa-volume-high text-base text-amber-600"></i>
                            읽어주기
                        </button>
                    </div>

                    <!-- Question Text -->
                    <div id="clue-text" class="text-lg sm:text-xl font-medium leading-relaxed text-slate-800 min-h-[80px] flex items-center">
                        퍼즐 판에서 낱말 칸을 선택해 주세요! 💡
                    </div>

                    <!-- Choseong Hint Result Display -->
                    <div id="choseong-display" class="hidden bg-amber-50 border border-amber-200 p-3 rounded-2xl flex items-center gap-2 text-amber-900 font-bold">
                        <span class="text-xs bg-amber-200 text-amber-950 px-2 py-0.5 rounded-md">초성 힌트</span>
                        <span id="choseong-text" class="text-xl tracking-widest font-black"></span>
                    </div>

                    <!-- Hint Purchase Action Buttons -->
                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <button onclick="useInitialHint()" class="bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 font-bold py-2.5 px-3 rounded-2xl text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all active:scale-95">
                            <i class="fa-regular fa-lightbulb text-amber-600"></i>
                            초성 힌트 (-5P)
                        </button>
                        <button onclick="useLetterHint()" class="bg-orange-50 hover:bg-orange-100 border border-orange-200 text-orange-900 font-bold py-2.5 px-3 rounded-2xl text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all active:scale-95">
                            <i class="fa-solid fa-key text-orange-600"></i>
                            한 글자 열기 (-15P)
                        </button>
                    </div>
                </div>

                <!-- Answer Input & Submission Box -->
                <div class="bg-white rounded-3xl p-5 border-2 border-amber-100 shadow-sm flex flex-col gap-4">
                    <label class="text-sm font-bold text-slate-500 flex items-center gap-1">
                        <i class="fa-solid fa-pen-to-square text-amber-500"></i> 정답 입력하기
                    </label>

                    <!-- Dynamic Input Cells Container -->
                    <div id="input-cells-container" class="flex flex-wrap justify-center gap-2 min-h-[56px] items-center">
                        <!-- Inputs will be dynamically generated -->
                    </div>

                    <!-- Submit Button -->
                    <button onclick="submitAnswer()" class="w-full bg-amber-400 hover:bg-amber-500 text-amber-950 font-black text-lg py-3.5 px-6 rounded-2xl shadow-sm border-2 border-amber-300 transition-all active:scale-98 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check text-xl"></i>
                        정답 확인하기
                    </button>
                </div>

            </section>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-100 border-t border-slate-200 py-4 text-center text-xs sm:text-sm text-slate-500 font-medium">
        보편적 학습 설계(UDL) 기반 느린 학습자용 한국사 교육 웹 앱
    </footer>

    <!-- Custom UDL Friendly Modal (No disruptive default alerts) -->
    <div id="custom-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full border-4 border-amber-200 shadow-2xl flex flex-col items-center text-center gap-4 animate-bounce-short">
            <div id="modal-icon" class="text-5xl">💡</div>
            <h3 id="modal-title" class="text-xl font-black text-slate-800">안내</h3>
            <p id="modal-message" class="text-base font-medium text-slate-600 leading-relaxed">메시지 내용</p>
            <button onclick="closeModal()" class="w-full bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold py-3 px-6 rounded-2xl border border-amber-300 text-base transition-all active:scale-95 mt-2">
                확인했어요
            </button>
        </div>
    </div>

