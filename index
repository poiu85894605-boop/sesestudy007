                { id: "a3", answer: "헤이그특사", initial_sound: "ㅎㅇㄱㅌㅅ", hint: "고종이 을사늑약의 부당함을 알리기 위해 **네덜란드 만국평화회의에 파견한 세 분의 사절**을 무엇이라 할까요?", x: 1, y: 5, direction: "across", number: 3 },
                { id: "a4", answer: "신간회", initial_sound: "ㅅㄱㅎ", hint: "민족주의 세력과 사회주의 세력이 손을 잡고 만든 **일제강점기 최대 규모의 민족 협동 전선 단체**는 무엇일까요?", x: 5, y: 3, direction: "across", number: 4 },
                { id: "a5", answer: "의열단", initial_sound: "ㅇㅇㄷ", hint: "신흥무관학교 출신인 신채호, 김원봉 등이 중심이 되어 조직한 **대표적인 무장 독립운동 단체**는 무엇일까요?", x: 3, y: 6, direction: "across", number: 5 },
                { id: "a6", answer: "광주학생항일운동", initial_sound: "ㄱㅈㅎㅅㅎㅇㅇㄷ", hint: "한일 학생 간의 충돌을 계기로 일어나 **삼일 운동 이후 가장 큰 규모로 전개된 학생 중심 항일 운동**은 무엇일까요?", x: 1, y: 8, direction: "across", number: 6 },
                { id: "a7", answer: "한국광복군", initial_sound: "ㅎㄱㅂㄱ", hint: "중국 충칭에서 창설된 **대한민국 임시정부 공식 군대**의 이름은 무엇일까요?", x: 2, y: 10, direction: "across", number: 7 },
                { id: "a8", answer: "모스크바삼상회의", initial_sound: "ㅁㅅㅋㅂㅅㅅㅎㅇ", hint: "광복 직후 미국, 영국, 소련의 외교관들이 모여 **한반도의 신탁 통지 문제와 임시정부 수립을 논의한 회의**는 무엇일까요?", x: 1, y: 12, direction: "across", number: 8 },
                { id: "a9", answer: "경제개발계획", initial_sound: "ㄱㅈㄱㅂㄱㅎ", hint: "정부가 주도하여 산업 구조를 근대화하고 **수출 중심의 경제 성장을 이루기 위해 추진한 장기 국가 계획**은 무엇일까요?", x: 8, y: 1, direction: "down", number: 9 },
                { id: "a10", answer: "외환위기", initial_sound: "ㅇㅎㅇㄱ", hint: "우리나라의 달러가 부족해져 **국제통화기금에 구제금융을 신청했던 국가적 경제 위기 상황**을 무엇이라 할까요?", x: 10, y: 8, direction: "down", number: 10 }
            ]
        };

        // Global Game State
        let currentStage = 'beginner';
        let userPoints = 0;
        let streakCount = 0;
        let activeWordId = null;
        let solvedWords = new Set();
        let openedHints = {}; // { wordId: { initial: boolean, revealedIndices: [] } }

        // Points structure by Stage
        const STAGE_POINTS = {
            beginner: 10,
            intermediate: 20,
            advanced: 30
        };

        window.onload = function() {
            switchStage('beginner');
        };

        function switchStage(stageKey) {
            currentStage = stageKey;
            activeWordId = null;

            // Update tab UI buttons
            document.querySelectorAll('.stage-btn').forEach(btn => {
                btn.className = "stage-btn flex-1 max-w-[160px] py-3 px-4 rounded-2xl font-bold text-base sm:text-lg border-2 border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:bg-slate-50 active:scale-95";
            });
            const activeBtn = document.getElementById(`btn-stage-${stageKey}`);
            if (activeBtn) {
                activeBtn.className = "stage-btn flex-1 max-w-[160px] py-3 px-4 rounded-2xl font-bold text-base sm:text-lg border-2 border-amber-300 bg-amber-400 text-amber-950 shadow-sm transition-all hover:brightness-105 active:scale-95";
            }

            renderBoard();
            resetHintPanel();
        }

        function renderBoard() {
            const container = document.getElementById('grid-container');
            container.innerHTML = '';

            const words = GAME_DATA[currentStage];
            
            // Calculate max grid bounds dynamically
            let maxX = 8, maxY = 8;
            words.forEach(w => {
                const endX = w.direction === 'across' ? w.x + w.answer.length - 1 : w.x;
                const endY = w.direction === 'down' ? w.y + w.answer.length - 1 : w.y;
                if (endX > maxX) maxX = endX;
                if (endY > maxY) maxY = endY;
            });

            // Grid CSS Layout setup
            container.style.display = 'grid';
            container.style.gridTemplateColumns = `repeat(${maxX}, minmax(36px, 48px))`;
            container.style.gridTemplateRows = `repeat(${maxY}, minmax(36px, 48px))`;
            container.style.gap = '4px';

            // Map cells
            const cellMap = {};
            words.forEach(w => {
                for (let i = 0; i < w.answer.length; i++) {
                    const cx = w.direction === 'across' ? w.x + i : w.x;
                    const cy = w.direction === 'down' ? w.y + i : w.y;
                    const key = `${cx},${cy}`;

                    if (!cellMap[key]) {
                        cellMap[key] = { x: cx, y: cy, words: [], number: null, letter: w.answer[i] };
                    }
                    cellMap[key].words.push(w.id);
                    if (i === 0 && !cellMap[key].number) {
                        cellMap[key].number = w.number;
                    }
                }
            });

            // Render cells into matrix
            for (let r = 1; r <= maxY; r++) {
                for (let c = 1; c <= maxX; c++) {
                    const key = `${c},${r}`;
                    const cellData = cellMap[key];

                    const cellDiv = document.createElement('div');
                    cellDiv.className = "relative rounded-xl flex items-center justify-center font-black text-base sm:text-lg cell-box border";

                    if (cellData) {
                        cellDiv.className += " bg-white border-slate-300 text-slate-800 cursor-pointer hover:border-amber-400 shadow-sm";
                        cellDiv.dataset.key = key;

                        // Display number indicator
                        if (cellData.number) {
                            const numSpan = document.createElement('span');
                            numSpan.className = "absolute top-0.5 left-1 text-[10px] text-amber-700 font-bold leading-none";
                            numSpan.innerText = cellData.number;
                            cellDiv.appendChild(numSpan);
                        }

                        // Text element
                        const textSpan = document.createElement('span');
                        textSpan.id = `cell-text-${key}`;
                        textSpan.className = "z-10";

                        // Check if solved
                        const isSolved = cellData.words.every(wid => solvedWords.has(wid));
                        if (isSolved) {
                            textSpan.innerText = cellData.letter;
                            cellDiv.classList.add('cell-correct');
                        }

                        cellDiv.appendChild(textSpan);

                        // Cell click action
                        cellDiv.onclick = () => {
                            selectWord(cellData.words[0]);
                        };
                    } else {
                        // Empty background slot
                        cellDiv.className += " bg-slate-200/50 border-transparent";
                    }

                    container.appendChild(cellDiv);
                }
            }
        }

        function selectWord(wordId) {
            activeWordId = wordId;
            const words = GAME_DATA[currentStage];
            const word = words.find(w => w.id === wordId);
            if (!word) return;

            // Highlight cells on board
            document.querySelectorAll('.cell-box').forEach(el => el.classList.remove('cell-selected'));

            for (let i = 0; i < word.answer.length; i++) {
                const cx = word.direction === 'across' ? word.x + i : word.x;
                const cy = word.direction === 'down' ? word.y + i : word.y;
                const cellEl = document.querySelector(`[data-key="${cx},${cy}"]`);
                if (cellEl && !cellEl.classList.contains('cell-correct')) {
                    cellEl.classList.add('cell-selected');
                }
            }

            // Update Clue Box
            const clueBadge = document.getElementById('clue-badge');
            clueBadge.innerText = `[힌트: ${'O'.repeat(word.answer.length)} - ${word.answer.length}글자]`;

            // Format bold text for keyword highlighting
            let formattedHint = word.hint.replace(/\*\*(.*?)\*\*/g, '<span class="key-highlight">$1</span>');
            document.getElementById('clue-text').innerHTML = formattedHint;

            // Update Choseong Display if unlocked
            updateChoseongUI(wordId);

            // Generate Input Boxes
            renderInputCells(word);
        }

        function renderInputCells(word) {
            const container = document.getElementById('input-cells-container');
            container.innerHTML = '';

            const isSolved = solvedWords.has(word.id);

            for (let i = 0; i < word.answer.length; i++) {
                const input = document.createElement('input');
                input.type = 'text';
                input.maxLength = 1;
                input.className = "w-11 h-12 text-center text-xl font-black rounded-xl border-2 border-slate-300 focus:border-amber-400 focus:bg-amber-50 outline-none transition-all shadow-sm";
                input.dataset.index = i;

                // Check letter hints or solved status
                const hintInfo = openedHints[word.id];
                if (isSolved) {
                    input.value = word.answer[i];
                    input.disabled = true;
                    input.classList.add('bg-green-100', 'border-green-400', 'text-green-800');
                } else if (hintInfo && hintInfo.revealedIndices && hintInfo.revealedIndices.includes(i)) {
                    input.value = word.answer[i];
                    input.disabled = true;
                    input.classList.add('bg-amber-100', 'border-amber-400', 'text-amber-800');
                }

                // Keyboard Navigation logic
                input.oninput = (e) => {
                    if (e.target.value) {
                        const nextInput = container.querySelector(`input[data-index="${i + 1}"]`);
                        if (nextInput) nextInput.focus();
                    }
                };

                input.onkeydown = (e) => {
                    if (e.key === 'Backspace' && !e.target.value) {
                        const prevInput = container.querySelector(`input[data-index="${i - 1}"]`);
                        if (prevInput) prevInput.focus();
                    } else if (e.key === 'Enter') {
                        submitAnswer();
                    }
                };

                container.appendChild(input);
            }

            // Focus first editable input
            if (!isSolved) {
                const firstEmpty = container.querySelector('input:not([disabled])');
                if (firstEmpty) firstEmpty.focus();
            }
        }

        function submitAnswer() {
            if (!activeWordId) {
                showModal("💡 단어 선택 필요", "먼저 십자말풀이 판에서 풀고 싶은 단어를 선택해 주세요!");
                return;
            }

            const word = GAME_DATA[currentStage].find(w => w.id === activeWordId);
            if (!word) return;

            if (solvedWords.has(word.id)) {
                showModal("✨ 이미 맞힌 문제", "이미 정답을 맞힌 문제입니다! 다른 문제를 풀어보세요.");
                return;
            }

            // Gather inputs
            const inputs = document.querySelectorAll('#input-cells-container input');
            let userString = "";
            inputs.forEach(inp => userString += inp.value.trim());

            if (userString.length < word.answer.length) {
                showModal("✏️ 글자 수 부족", "모든 칸에 정답 글자를 입력해 주세요!");
                return;
            }

            // Check Correct Answer
            if (userString === word.answer) {
                // Mark solved
                solvedWords.add(word.id);
                
                // Score & Streak calculation
                const baseReward = STAGE_POINTS[currentStage];
                streakCount++;
                let bonus = 0;
                if (streakCount % 3 === 0) {
                    bonus = 5; // Bonus for 3 consecutive correct answers
                }
                userPoints += (baseReward + bonus);

                updateScoreUI();
                renderBoard();
                selectWord(word.id);

                let rewardMsg = `<b>+${baseReward} 포인트</b>를 획득했습니다!`;
                if (bonus > 0) {
                    rewardMsg += `<br><span class="text-orange-600 font-bold">🔥 3연속 성공 보너스 +5P 추가!</span>`;
                }

                showModal("🎉 참 잘했어요!", `정답입니다! <br>${rewardMsg}`, "🌟");
            } else {
                // Reset streak gently on error without screen shaking
                streakCount = 0;
                updateScoreUI();
                showModal("💡 다시 생각해 볼까요?", "아쉽게도 정답이 아니에요.<br>힌트를 다시 읽어보고 차근차근 풀어보세요!", "🤔");
            }
        }

        function useInitialHint() {
            if (!activeWordId) {
                showModal("💡 단어 선택 필요", "힌트를 사용할 단어를 먼저 선택해 주세요.");
                return;
            }

            if (userPoints < 5) {
                showModal("⭐ 포인트 부족", "초성 힌트를 사용하려면 <b>5 포인트</b>가 필요해요.<br>정답을 맞혀 포인트를 모아보세요!", "🪙");
                return;
            }

            if (!openedHints[activeWordId]) openedHints[activeWordId] = { initial: false, revealedIndices: [] };

            if (openedHints[activeWordId].initial) {
                showModal("✨ 힌트 이미 열림", "이미 초성 힌트를 확인하셨습니다.");
                return;
            }

            userPoints -= 5;
            openedHints[activeWordId].initial = true;
            updateScoreUI();
            updateChoseongUI(activeWordId);
            showModal("💡 초성 힌트 열림", "초성 힌트가 아래에 공개되었습니다!", "🔓");
        }

        function useLetterHint() {
            if (!activeWordId) {
                showModal("💡 단어 선택 필요", "힌트를 사용할 단어를 먼저 선택해 주세요.");
                return;
            }

            const word = GAME_DATA[currentStage].find(w => w.id === activeWordId);
            if (!word || solvedWords.has(word.id)) return;

            if (userPoints < 15) {
                showModal("⭐ 포인트 부족", "한 글자 열기를 사용하려면 <b>15 포인트</b>가 필요해요.", "🪙");
                return;
            }

            if (!openedHints[activeWordId]) openedHints[activeWordId] = { initial: false, revealedIndices: [] };

            const revealed = openedHints[activeWordId].revealedIndices;
            
            // Find unrevealed indices
            const unrevealed = [];
            for (let i = 0; i < word.answer.length; i++) {
                if (!revealed.includes(i)) unrevealed.push(i);
            }

            if (unrevealed.length === 0) {
                showModal("✨ 힌트 이미 완결", "모든 글자가 이미 열려있습니다.");
                return;
            }

            // Pick random position to reveal
            const randIdx = unrevealed[Math.floor(Math.random() * unrevealed.length)];
            revealed.push(randIdx);

            userPoints -= 15;
            updateScoreUI();
            renderInputCells(word);
            showModal("🔍 한 글자 공개!", `'<b>${word.answer[randIdx]}</b>' 글자가 입력창에 채워졌습니다!`, "🔑");
        }

        function updateChoseongUI(wordId) {
            const word = GAME_DATA[currentStage].find(w => w.id === wordId);
            const displayBox = document.getElementById('choseong-display');
            const displayText = document.getElementById('choseong-text');

            if (word && openedHints[wordId] && openedHints[wordId].initial) {
                displayBox.classList.remove('hidden');
                displayText.innerText = word.initial_sound;
            } else {
                displayBox.classList.add('hidden');
            }
        }

        function speakCurrentHint() {
            if (!activeWordId) {
                showModal("💡 읽어주기 안내", "먼저 읽어들을 퀴즈 문제를 선택해 주세요.");
                return;
            }

            const word = GAME_DATA[currentStage].find(w => w.id === activeWordId);
            if (!word) return;

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Stop current speech
                const cleanText = word.hint.replace(/\*\*/g, '');
                const utterance = new SpeechSynthesisUtterance(cleanText);
                utterance.lang = 'ko-KR';
                utterance.rate = 0.85; // Natural slow speech speed for slow learners
                window.speechSynthesis.speak(utterance);
            } else {
                showModal("🔊 음성 미지원", "사용 중인 브라우저가 음성 읽어주기를 지원하지 않습니다.");
            }
        }

        function updateScoreUI() {
            document.getElementById('user-points').innerText = userPoints;
            document.getElementById('streak-count').innerText = streakCount;
        }

        function resetHintPanel() {
            document.getElementById('clue-badge').innerText = '[힌트: 단어를 선택하세요]';
            document.getElementById('clue-text').innerText = '퍼즐 판에서 낱말 칸을 선택해 주세요! 💡';
            document.getElementById('choseong-display').classList.add('hidden');
            document.getElementById('input-cells-container').innerHTML = '';
        }

        function showModal(title, message, icon = "💡") {
            document.getElementById('modal-title').innerHTML = title;
            document.getElementById('modal-message').innerHTML = message;
            document.getElementById('modal-icon').innerText = icon;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }
    </script>
</body>
