                { id: "b9", answer: "광복", initial_sound: "ㄱㅂ", hint: "일제의 억압에서 벗어나 빼앗긴 나라와 빛을 되찾았다는 뜻의 기념일은 무엇일까요?", x: 3, y: 4, direction: "across", number: 9 },
